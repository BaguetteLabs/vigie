    "cli.usage" : {
      "comment" : "vigie CLI usage text. Command names and arguments are not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage: vigie <command> [options]\n\nCommands:\n  event <topic> [json]  Send an event to Vigie (payload from the argument, else stdin, else {})\n  reload                Ask Vigie to reload its config from disk\n  hook <agent>          Forward an agent hook event (called by agent hooks)\n  version               Print the command name and bundle identifier"
