    "cli.agent.synopsis" : {
      "comment" : "One-line synopsis of vigie agent, appended to its usage errors. Flags and status values are not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vigie agent --agent <id> --session <id> (--status working|blocked|done|failed|idle | --end) [--cwd <path>] [--message <text>]"
          }
        }
      }
    },
    "cli.error.deliveryFailed" : {
      "comment" : "stderr line when vigie event/reload could neither reach the running app nor write its spool file.",
