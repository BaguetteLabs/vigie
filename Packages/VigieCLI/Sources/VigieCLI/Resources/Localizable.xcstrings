    "cli.usage" : {
      "comment" : "vigie CLI usage text. Command names and arguments are not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage: vigie <command> [options]\n\nCommands:\n  event <topic> [json]  Send an event to Vigie (payload from the argument, else stdin, else {})\n  reload                Ask Vigie to reload its config from disk\n  hook <agent>          Forward an agent hook event (called by agent hooks)\n  agent --agent <id> --session <id> (--status <status> | --end) [--cwd <path>] [--message <text>]\n                        Report a session of any other agent; status is working, blocked, done, failed or idle\n  version               Print the command name and bundle identifier"
          }
        }
      }
    }
  },
  "version" : "1.0"
