    "claude.plan.consent.explanation" : {
      "comment" : "Consent text shown before Vigie reads Claude Code's stored login. Explains the use and limits.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigie will read the login Claude Code already stored on this Mac, only to fetch your plan usage. It reads it at each refresh, keeps it in memory only, never copies, renews or changes it, and never syncs this choice."
          }
        }
      }
    },
    "claude.plan.install.summary" : {
      "comment" : "Integration diff summary. %1$lld = number of hook events, %2$@ = settings file path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Vigie hooks for %1$lld events to %2$@"
          }
        }
      }
    },
    "claude.plan.name" : {
