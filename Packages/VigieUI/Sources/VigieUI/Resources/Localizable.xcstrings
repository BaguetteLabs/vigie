    "script.confirmation.explanation": {
      "comment": "Script Confirmation: what Confirm and Decline do.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm lets this file run on this Mac. Decline disables it on this Mac only; other Macs are not affected. Any change to the file asks again."
          }
        }
      }
    },
    "script.confirmation.fileText": {
      "comment": "Script Confirmation disclosure: shows the whole file exactly as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole file as text"
          }
