    },
    "script.confirmation.installNote": {
      "comment": "Script Confirmation, link install: what Confirm and Decline do (Story 12.9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm saves this file in your scripts folder on this Mac and runs it. Decline or Cancel leaves nothing behind."
          }
        }
      }
    },
