      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USAGE"
          }
        }
      }
    },
    "agentsUsage.plan.problem.formatChanged" : {
      "comment" : "Alert body: the unofficial plan usage endpoint changed shape.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan usage service changed. Vigie keeps the last values; local usage keeps working until an update fixes it."
          }
        }
      }
    },
    "agentsUsage.plan.problem.network" : {
      "comment" : "Alert body: the plan usage endpoint could not be reached or failed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigie could not reach the plan usage service. It keeps the last values and retries every 5 minutes; local usage keeps working."
          }
        }
      }
    },
    "agentsUsage.plan.problem.signIn" : {
      "comment" : "Alert body when the credential is refused, expired or missing. %@ is the app whose login is used, e.g. Claude Code.",
