      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to %@ again, or paste a token."
          }
        }
      }
    },
    "agentsUsage.plan.problem.title" : {
      "comment" : "Setup-problem alert title when plan usage cannot be fetched. %@ is the provider, e.g. Claude.",
