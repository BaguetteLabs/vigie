{
  "sourceLanguage" : "en",
  "strings" : {
    "shelf.expiring.body" : {
      "comment" : "macOS notification body (shelf.expiring). Arg = hours left.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves the shelf in %lld h. Pin it to keep it."
          }
        }
      }
    },
    "shelf.expiring.bodyTrash" : {
      "comment" : "macOS notification body (shelf.expiring) for a copy or saved item. Arg = hours left.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves to the Trash in %lld h. Pin it to keep it."
          }
        }
      }
    },
    "shelf.expiring.count" : {
