      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image"
          }
        }
      }
    },
    "shelf.saved.linkName" : {
      "comment" : "File name (without extension) of a dragged link without a host, saved as .webloc.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link"
          }
        }
      }
    },
    "shelf.saved.textName" : {
      "comment" : "File name (without extension) of dragged text saved on the shelf when its first line is empty.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text"
          }
        }
      }
    },
    "shelf.setting.expiryNotification" : {
      "comment" : "Settings › Shelf: expiry_notification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify before an item expires"
          }
        }
      }
    },
    "shelf.setting.expiryNotification.help" : {
      "comment" : "Settings › Shelf: help under expiry_notification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS notification 24 hours before an item expires. No peek, no sound."
          }
        }
      }
    },
    "shelf.setting.mode" : {
      "comment" : "Settings › Shelf: reference or copy.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stash files as"
          }
        }
      }
    },
    "shelf.setting.mode.help" : {
      "comment" : "Settings › Shelf: help under mode.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reference keeps a link to the original file; copy stores a copy, so the original can be deleted."
          }
        }
      }
    },
    "shelf.setting.ttl" : {
      "comment" : "Settings › Shelf: how long stashed items stay (ttl).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep items for"
          }
        }
      }
    },
    "shelf.setting.ttl.help" : {
      "comment" : "Settings › Shelf: help under ttl.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unpinned items expire after this long, for example 7d or 12h. References leave the shelf; copies and saved items go to the Trash."
          }
        }
      }
    },
    "shelf.stash.a11y.days" : {
      "comment" : "VoiceOver label of the Stash zone. Arg 1 = ttl in days, arg 2 = items.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stash, keep %#@days@, %#@items@"
          },
          "substitutions" : {
            "days" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "zero" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg days"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
