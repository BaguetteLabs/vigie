    "shelf.setting.expiryNotification" : {
      "comment" : "Settings › Shelf: expiry_notification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify before an item expires"
          }
        }
      }
    },
    "shelf.setting.expiryNotification.help" : {
      "comment" : "Settings › Shelf: help under expiry_notification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS notification 24 hours before an item expires. No peek, no sound."
          }
        }
      }
    },
    "shelf.setting.mode" : {
      "comment" : "Settings › Shelf: reference or copy.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stash files as"
          }
        }
      }
    },
    "shelf.setting.mode.help" : {
      "comment" : "Settings › Shelf: help under mode.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reference keeps a link to the original file; copy stores a copy, so the original can be deleted."
          }
        }
      }
    },
    "shelf.setting.ttl" : {
      "comment" : "Settings › Shelf: how long stashed items stay (ttl).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep items for"
          }
        }
      }
    },
    "shelf.setting.ttl.help" : {
      "comment" : "Settings › Shelf: help under ttl.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unpinned items expire after this long, for example 7d or 12h. References leave the shelf; copies and saved items go to the Trash."
          }
        }
      }
    },
    "shelf.stash.a11y.days" : {
