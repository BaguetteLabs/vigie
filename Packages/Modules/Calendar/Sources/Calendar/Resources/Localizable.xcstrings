          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld calendar with events"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld calendars with events"
                }
              }
            }
          }
        }
      }
    },
