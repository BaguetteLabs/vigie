      }
    },
    "time.setting.breaks.enabled.help" : {
      "comment" : "Settings help for break reminders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a stretch of work at the Mac, remind me to take a break. Time away from the Mac counts as a break on its own."
          }
        }
      }
    },
    "time.setting.breaks.work" : {
      "comment" : "Settings › Time: time at the Mac before a break reminder (default 55 min).",
