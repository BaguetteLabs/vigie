      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being away for this long counts as a break."
          }
        }
      }
    },
    "time.setting.breaks.awayAfter" : {
      "comment" : "Settings › Time: how long without input before Vigie counts you as away (default 90 s).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Away after"
          }
        }
      }
    },
    "time.setting.breaks.awayAfter.help" : {
      "comment" : "Settings help for away_after.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No keyboard, mouse or trackpad input for this long, or a locked or sleeping screen, counts as away. Vigie never uses the camera."
          }
        }
      }
    },
    "time.setting.breaks.style" : {
      "comment" : "Settings › Time: peek (the break peek, and its sound if set) or quiet (no peek, no sound: BREAK DUE on the closed notch).",
