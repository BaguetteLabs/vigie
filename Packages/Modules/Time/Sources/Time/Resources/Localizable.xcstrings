      "comment" : "Settings help for the work length.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only time at the Mac counts; time away does not."
          }
        }
      }
    },
    "time.setting.breaks.length" : {
      "comment" : "Settings › Time: break length (default 5 min).",
