      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Break reminder strength"
          }
        }
      }
    },
    "time.setting.breaks.style.help" : {
      "comment" : "Settings help for the break reminder strength.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "peek shows the break peek; quiet shows only BREAK DUE in the closed notch, with no sound."
