          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrations"
          }
        }
      }
    },
    "script.error.action_count" : {
      "comment" : "Script schema error. %@ = key path of the action.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: needs exactly one of open, run or copy."
          }
        }
      }
    },
    "script.error.document" : {
      "comment" : "Script schema error: names the whole document when the problem is not one key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the document"
          }
        }
      }
    },
    "script.error.duplicate" : {
      "comment" : "Script schema error. %1$@ = key path, %2$@ = the repeated value.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: “%2$@” is listed twice."
          }
        }
      }
    },
    "script.error.empty" : {
      "comment" : "Script schema error. %@ = key path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: must not be empty."
          }
        }
      }
    },
    "script.error.invalid_format" : {
      "comment" : "Script schema error. %1$@ = key path, %2$@ = the value, %3$@ = expected format (script.format.*).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: “%2$@” is not %3$@."
          }
        }
      }
    },
    "script.error.missing_key" : {
      "comment" : "Script schema error. %@ = key path, e.g. settings[1].label.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: required key is missing."
          }
        }
      }
    },
    "script.error.not_positive" : {
      "comment" : "Script schema error. %@ = key path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: must be greater than zero."
          }
        }
      }
    },
    "script.error.reserved_key" : {
      "comment" : "Script schema error. %1$@ = key path, %2$@ = the reserved setting key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: “%2$@” is reserved by Vigie (enabled, side, priority, surfaces, notify)."
          }
        }
      }
    },
    "script.error.unknown_key" : {
      "comment" : "Script schema error. %@ = key path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: unknown key."
