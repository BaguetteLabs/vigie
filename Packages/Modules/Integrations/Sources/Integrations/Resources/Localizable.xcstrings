        }
      }
    },
    "script.error.unknown_value" : {
      "comment" : "Script schema error. %1$@ = key path, %2$@ = the value, %3$@ = accepted values.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: unknown value “%2$@” (expected one of: %3$@)."
          }
        }
      }
    },
    "script.error.unsupported_schema" : {
      "comment" : "Script schema error. %1$@ = key path, %2$lld = version in the file, %3$lld = newest supported version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: schema version %2$lld is not supported by this version of Vigie (it reads up to %3$lld)."
          }
        }
      }
    },
    "script.error.wrong_type" : {
      "comment" : "Script schema error. %1$@ = key path, %2$@ = expected kind (script.kind.*).",
