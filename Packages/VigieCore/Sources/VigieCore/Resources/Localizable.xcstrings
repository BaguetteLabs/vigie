    "vigiecore.setup.title.secretsUnavailable": {
      "comment": "Setup alert title: the build cannot use the Keychain (Story 7.2).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets are unavailable in this build"
          }
        }
      }
    },
    "vigiecore.setup.body.secretsUnavailable": {
      "comment": "Setup alert body: why secrets are unavailable. No action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build is not signed with the keychain entitlement, so tokens and other secrets cannot be stored."
          }
        }
      }
    },
    "vigiecore.setup.category.secrets": {
      "comment": "Kicker category after SETUP, for secret storage problems. Uppercase.",
