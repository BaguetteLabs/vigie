          "stringUnit": {
            "state": "translated",
            "value": "Alerts"
          }
        }
      }
    },
    "settings.section.closedNotch": {
      "comment": "Section heading in Settings \u203a Appearance for the closed-notch settings ([closed]).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed notch"
          }
        }
      }
    },
    "settings.section.statusColors": {
      "comment": "Section heading in Settings \u203a Appearance for custom status, pace and warning colors.",
      "extractionState": "manual",
      "localizations": {
