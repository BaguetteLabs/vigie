    },
    "settings.cli.stale": {
      "comment": "CLI status in Settings › General.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command-line tool points to an older copy of Vigie. Vigie repairs it at the next launch."
          }
        }
      }
    },
    "settings.error.fileHasErrors": {
      "comment": "Inline Settings error; %@ is the file name.",
