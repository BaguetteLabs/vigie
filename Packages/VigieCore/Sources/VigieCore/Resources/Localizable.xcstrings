{
  "sourceLanguage": "en",
  "strings": {
    "menu.quit": {
      "comment": "Closed notch context menu: quit the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Vigie"
          }
        }
      }
    },
    "menu.settings": {
      "comment": "Closed notch context menu: open settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "peek.action.dismiss": {
      "comment": "Peek secondary action: retract the peek and cancel its reminder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "peek.action.focusTerminal": {
      "comment": "Peek primary action: bring the session's terminal tab forward.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus terminal"
          }
        }
      }
    },
    "peek.action.open": {
      "comment": "Peek primary action for other module alerts: perform the alert's action.",
