        }
      }
    },
    "settings.cli.pathHint": {
      "comment": "CLI PATH hint in Settings › General; %@ is the bin folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not on your shell's PATH. Add this line to your shell profile:"
