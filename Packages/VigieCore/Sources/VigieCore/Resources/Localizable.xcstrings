      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SECRETS"
          }
        }
      }
    },
    "settings.error.secretKey": {
      "comment": "Inline Settings error: ConfigError.secretKey (a secret setting cannot be written to config).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting is stored in the Keychain, not in the config file."
