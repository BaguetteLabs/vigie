// Signing and version settings of the Vigie app target (project.yml `configFiles`).
//
// Version.xcconfig is generated by Scripts/version.sh (Story 6.4) and gitignored; Scripts/ci-local.sh and the CI
// "version" step create it before `xcodegen generate`.
#include "Version.xcconfig"

// Ad-hoc by default. Ad-hoc signatures have no stable designated requirement, so macOS forgets Keychain
// "Always Allow" answers at every rebuild. Run Scripts/dev-signing.sh once per Mac: it writes
// Signing.local.xcconfig (gitignored) with this Mac's Apple Development (or self-signed "Vigie Dev Signing")
// identity. CI passes CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=NO on the command line, which wins over both.
// Release keeps ad-hoc until Developer ID signing (Story 6.1).
CODE_SIGN_IDENTITY = -

#include? "Signing.local.xcconfig"
