// Signing and version settings of the Vigie app target (project.yml `configFiles`; Story 6.1, AD-17, AD-20).
// project.yml sets none of these keys on the target, so this file and Signing.local.xcconfig are the only source.
//
// Version.xcconfig is generated by Scripts/version.sh (Story 6.4) and gitignored; Scripts/ci-local.sh and the CI
// "version" step create it before `xcodegen generate`.
#include "Version.xcconfig"

// Every configuration: unsandboxed (no App Sandbox entitlement), Hardened Runtime on.
ENABLE_HARDENED_RUNTIME = YES

// Debug (dev flavor, fr.baguettelabs.vigie.dev): ad-hoc by default, so any Mac and CI can build it. Ad-hoc
// signatures have no stable designated requirement and cannot carry `keychain-access-groups` (Xcode refuses it
// without a profile, AMFI kills the binary), so they use Vigie.entitlements and SecretStore reports "unavailable".
// Run `Scripts/dev-signing.sh --team <TeamID>` once per Mac: it writes Signing.local.xcconfig (gitignored) with
// automatic signing for that team (Apple Development identity + Xcode-managed `.dev` profile with Keychain
// Sharing) and switches Debug to Vigie.signed.entitlements. CI passes CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=NO
// on the command line, which wins over both files.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS = Vigie.entitlements

// Release (fr.baguettelabs.vigie): Developer ID Application of Baguette Labs, manual style, the "Vigie Developer
// ID" provisioning profile (explicit App ID, Keychain Sharing), apple-events + keychain-access-groups only. The
// team id is not a secret; release.yml (Story 6.2) imports the certificate and installs the profile, then builds
// with these settings unchanged. Notarization needs a secure timestamp. Building Release on a Mac without the
// certificate needs CODE_SIGNING_ALLOWED=NO. Maintainer steps: docs/release-setup.md.
CODE_SIGN_STYLE[config=Release] = Manual
DEVELOPMENT_TEAM[config=Release] = BWMPMACCYZ
CODE_SIGN_IDENTITY[config=Release] = Developer ID Application
PROVISIONING_PROFILE_SPECIFIER[config=Release] = Vigie Developer ID
CODE_SIGN_ENTITLEMENTS[config=Release] = Vigie.signed.entitlements
OTHER_CODE_SIGN_FLAGS[config=Release] = --timestamp
// No get-task-allow in release builds (notarization rejects it); Debug keeps it for the debugger.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

#include? "Signing.local.xcconfig"
